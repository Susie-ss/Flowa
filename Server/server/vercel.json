{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/preview.html", "destination": "/preview.html" },
    { "source": "/(.*)", "destination": "/public/$1" },
    { "source": "/(.*)", "destination": "/public/index.html" }
  ]
}
