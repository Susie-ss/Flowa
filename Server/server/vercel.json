{
  "version": 2,
  "public": true,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(css|js|libs|favicon\\.png)(.*)",
      "dest": "/public/$1$2"
    },
    {
      "src": "/preview\\.html",
      "dest": "/public/preview.html"
    },
    {
      "src": "/(login|register|share/.*)",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
